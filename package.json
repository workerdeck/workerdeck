{
  "name": "workerdeck-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "Run a coding agent — Claude Code, OpenAI Codex, or any model provider — as a session you can watch, steer, and embed. Gateway + wire protocol + web dashboard, with iOS and VS Code clients.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:extras",
    "typecheck:extras": "tsgo -p smoke/tsconfig.json && tsgo -p examples/tsconfig.json",
    "version:set": "pnpm --filter \"./packages/*\" --filter \"./apps/vscode\" --filter \"./apps/embedded\" exec npm version --no-git-tag-version --force",
    "publish:all": "pnpm publish -r --access public",
    "test": "turbo run test",
    "lint": "oxlint",
    "clean": "turbo run clean",
    "deploy:guard": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register packages/cli/src/cli.ts guard",
    "cli": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register packages/cli/src/cli.ts",
    "dashboard": "turbo run build --filter=@workerdeck/web --only",
    "dev:web": "WORKER_URL=http://${WD_DEV_HOST:-127.0.0.1}:8787 pnpm --filter @workerdeck/web run dev",
    "dev:server": "pnpm cli --config examples/dev-server.config.mjs --host ${WD_DEV_HOST:-127.0.0.1} --insecure-host ${WD_DEV_HOST:-127.0.0.1}",
    "start:prod": "pnpm build && node packages/cli/build/cli.mjs --config examples/prod-server.config.mjs --port ${WD_PROD_PORT:-8788} --host ${WD_DEV_HOST:-127.0.0.1} --insecure-host ${WD_DEV_HOST:-127.0.0.1}",
    "smoke:sandbox": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/sandbox.ts",
    "smoke:live": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/ai-sdk-live.ts",
    "smoke:sdk": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/sdk-client.ts",
    "smoke:media": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/media.ts",
    "smoke:mcp": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/mcp-live.ts",
    "smoke:codex": "node --env-file-if-exists=.env --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/codex.ts",
    "smoke:restart": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/restart.ts",
    "smoke:attach": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/attach-bytes.ts",
    "smoke:push": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register smoke/push.ts",
    "example:server": "node --env-file-if-exists=.env --conditions=@workerdeck/source --import @swc-node/register/esm-register examples/provider-server.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/moonshotai": "^3.0.43",
    "@ai-sdk/openai": "^4.0.53",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.31.0",
    "@openai/codex": "~0.151.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@workerdeck/client": "workspace:*",
    "@workerdeck/core": "workspace:*",
    "@workerdeck/protocol": "workspace:*",
    "@workerdeck/react": "workspace:*",
    "@workerdeck/sandbox": "workspace:*",
    "@workerdeck/server": "workspace:*",
    "ai": "^7.0.87",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.12",
    "vitest": "^4.1.11",
    "workerdeck": "workspace:*",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
