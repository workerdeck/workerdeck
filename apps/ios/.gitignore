# SwiftPM build products (agents use suffixed scratch paths too)
.build/
.build-*/
# XcodeGen output — regenerate with `xcodegen generate`
*.xcodeproj
# Generated from project.yml's `info.properties` — edit that, not this
App/Info.plist
# Likewise from `entitlements.properties`
App/WorkerDeckApp.entitlements
# Xcode user state
xcuserdata/
.swiftpm/
DerivedData/
# scripts/deploy.sh builds here; the -sim suffix is the simulator counterpart
DerivedData-*/
# Local device/team for scripts/deploy.sh — machine-specific, never committed
.deploy.env
