{
  "name": "@workerdeck/embedded-example",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of an embedded WorkerDeck: a wiki SPA whose right-hand sidebar drives sandboxed agent sessions, served with the gateway from one origin.",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "reset": "rimraf .embedded",
    "build": "vite build",
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=../../.env --conditions=@workerdeck/source --import @swc-node/register/esm-register src/main.ts",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=../../.env --conditions=@workerdeck/source --import @swc-node/register/esm-register src/main.ts",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.web.json"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@silkweave/core": "^5.2.0",
    "@silkweave/mcp": "^5.2.0",
    "@silkweave/trpc": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@workerdeck/client": "workspace:*",
    "@workerdeck/core": "workspace:*",
    "@workerdeck/protocol": "workspace:*",
    "@workerdeck/react": "workspace:*",
    "@workerdeck/sandbox": "workspace:*",
    "@workerdeck/server": "workspace:*",
    "@workerdeck/ui": "workspace:*",
    "ai": "^7.0.87",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "zod": "^3.25.76"
  }
}
