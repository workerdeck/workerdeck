node_modules/
build/
dist/
*.vsix
_docs/
.turbo/
*.log
.DS_Store
.env
.env.*
.mcp.json
*.pem
*.key
# Apple signing/APNs keys — a p8 downloads exactly once and serves the whole team.
*.p8
.npmrc
.astro/

# roam-code local index (generated by `roam init`)
.roam/
.roamignore

# Dev-server state: the profile store (examples/provider-server.ts) and the default
# parked-session directory (createFileSessionStore) — the latter holds transcripts.
.workerdeck/
# Pre-rebrand name. Nothing writes here any more, but existing checkouts still have
# the directory — and it holds provider API keys, so it must stay ignored.
.claude-worker/

# The CLI's on-disk test fixtures (config files, fake dashboard roots).
packages/cli/test/.tmp-*/

# iOS app build output. The sources live on `feat/ios-app` and carry their own
# apps/ios/.gitignore, but the generated files survive a branch switch — so they
# have to be ignored here too, or master shows 1400+ untracked artifacts.
# `xcodegen generate` rebuilds the project; Info.plist comes from project.yml.
apps/ios/**/.build/
apps/ios/**/.build-*/
apps/ios/**/.swiftpm/
apps/ios/*.xcodeproj/
apps/ios/App/Info.plist
apps/ios/App/WorkerDeckApp.entitlements
DerivedData/
xcuserdata/
.silktree/
# Throwaway UI harnesses: a real browser and a real layout engine for a component
# that only misbehaves under one (the virtualized transcript). Useful, but not a
# published surface of any package it happens to sit in.
**/.virt-harness/

# Storybook static build (packages/ui). The catalog is dev-only and unpublished.
storybook-static/
