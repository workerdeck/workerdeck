{
  "name": "@workerdeck/core",
  "version": "4.3.0",
  "type": "module",
  "description": "The WorkerDeck session runner: drives Claude Code, OpenAI Codex and any AI SDK provider behind one Runner interface with a push-based input queue, promotes canUseTool calls into pending approvals, normalizes SDKMessages into wire-protocol events, and keeps a seq-numbered event log for attach/replay. Pure library, no transport.",
  "license": "MIT",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@workerdeck/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.91",
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@workerdeck/protocol": "workspace:*",
    "@workerdeck/sandbox": "workspace:*",
    "ai": "^7.0.163"
  },
  "peerDependencies": {
    "@openai/codex": ">=0.149.0 <0.167.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.31.0",
    "@openai/codex": "~0.166.0",
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.4",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerdeck/workerdeck.git",
    "directory": "packages/core"
  },
  "homepage": "https://workerdeck.github.io/workerdeck/",
  "bugs": "https://github.com/workerdeck/workerdeck/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "agent-sdk",
    "session",
    "runner"
  ],
  "publishConfig": {
    "access": "public"
  }
}
