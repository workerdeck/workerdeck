{
  "name": "@workerdeck/ui",
  "version": "4.3.0",
  "type": "module",
  "description": "Styled agent-control component library for WorkerDeck: session panel, transcript with streaming, tool-call cards, permission prompts, session list, composer. Tailwind v4 + Base UI + cva. Pairs with the headless @workerdeck/react layer.",
  "license": "MIT",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build",
    "src"
  ],
  "exports": {
    ".": {
      "@workerdeck/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    },
    "./workspace": {
      "@workerdeck/source": "./src/workspace.ts",
      "types": "./build/workspace.d.mts",
      "default": "./build/workspace.mjs"
    },
    "./format": {
      "@workerdeck/source": "./src/format.ts",
      "types": "./build/format.d.mts",
      "default": "./build/format.mjs"
    },
    "./theme.css": "./src/styles/theme.css",
    "./scoped.css": "./build/scoped.css"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown && node scripts/build-scoped-css.mjs",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "vite",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@workerdeck/client": "workspace:*",
    "@workerdeck/protocol": "workspace:*",
    "@workerdeck/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "@xterm/addon-fit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.22.14",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerdeck/workerdeck.git",
    "directory": "packages/ui"
  },
  "homepage": "https://workerdeck.github.io/workerdeck/",
  "bugs": "https://github.com/workerdeck/workerdeck/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "react",
    "components",
    "tailwind",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
