{
  "name": "@workerdeck/react",
  "version": "0.22.0",
  "type": "module",
  "description": "Headless React layer for WorkerDeck: session hook + pure transcript and sessions-list reducers. No styling opinion — @workerdeck/ui is the styled layer on top.",
  "license": "MIT",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@workerdeck/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@workerdeck/client": "workspace:*",
    "@workerdeck/protocol": "workspace:*",
    "@workerdeck/sandbox": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.31.0"
  },
  "peerDependenciesMeta": {
    "@jitl/quickjs-singlefile-browser-release-asyncify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@workerdeck/core": "workspace:*",
    "@workerdeck/server": "workspace:*",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "^0.31.0",
    "@jitl/quickjs-singlefile-browser-release-asyncify": "^0.31.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.1",
    "react": "^19.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "vitest": "^3.2.0",
    "ws": "^8.21.1"
  },
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerdeck/workerdeck.git",
    "directory": "packages/react"
  },
  "homepage": "https://workerdeck.github.io/workerdeck/",
  "bugs": "https://github.com/workerdeck/workerdeck/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "react",
    "hooks",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  }
}
