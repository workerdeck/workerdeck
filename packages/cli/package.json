{
  "name": "workerdeck",
  "version": "0.7.0",
  "type": "module",
  "description": "Turnkey WorkerDeck instance: `npx workerdeck` runs the session gateway and the full dashboard on one port. The @workerdeck/* packages are the libraries you embed; this is the service you run.",
  "license": "MIT",
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "bin": {
    "workerdeck": "./build/cli.mjs"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "@workerdeck/source": "./src/index.ts",
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run",
    "dev": "node --conditions=@workerdeck/source --import @swc-node/register/esm-register src/cli.ts"
  },
  "dependencies": {
    "@workerdeck/server": "workspace:*",
    "@workerdeck/web": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.217",
    "@workerdeck/protocol": "workspace:*",
    "@types/ws": "^8.5.13",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.41",
    "@types/node": "^22.10.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "vitest": "^3.2.0",
    "ws": "^8.21.1"
  },
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerdeck/workerdeck.git",
    "directory": "packages/cli"
  },
  "homepage": "https://workerdeck.github.io/workerdeck/",
  "bugs": "https://github.com/workerdeck/workerdeck/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent",
    "cli",
    "dashboard",
    "server"
  ],
  "publishConfig": {
    "access": "public"
  }
}
