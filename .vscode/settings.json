{
  "js/ts.experimental.useTsgo": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/.turbo": true,
    "**/build": true,
    "**/dist": true,
    ".roam": true,
    ".silktree": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/*.code-search": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },
  "js/ts.format.semicolons": "remove"
}
