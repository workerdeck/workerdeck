{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/build/**", "**/node_modules/**"],
  "rules": {
    "no-unused-vars": "warn",
    "curly": "error",
    "unicorn/no-array-sort": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/switch-case-braces": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "wd/module-func-style": "error",
    "wd/no-stacked-jsdoc": "error",
    "wd/max-comment-lines": "warn"
  },
  "overrides": [
    {
      "files": ["packages/web/monaco-no-language-services.js"],
      "rules": {
        "unicorn/require-module-specifiers": "off",
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "smoke/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "wd/max-comment-lines": "off"
      }
    },
    {
      "files": ["packages/ui/dev/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["lint/**"],
      "rules": {
        "wd/module-func-style": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/prompt-area/**"],
      "rules": {
        "wd/module-func-style": "off",
        "wd/max-comment-lines": "off"
      }
    }
  ],
  "jsPlugins": ["./lint/wd-plugin.js"]
}
